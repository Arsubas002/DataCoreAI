  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "demo",
            "title": "Mode",
            "default": "demo"
          },
          "question": {
            "type": "string",
            "enum": [
              "revenue",
              "average",
              "top_products",
              "stock_alerts"
            ],
            "title": "Question"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          },
          "generative": {
            "type": "boolean",
            "const": false,
            "title": "Generative",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "text",
          "sources"
        ],
        "title": "Answer"
      },
      "AssistantRequest": {
        "properties": {
          "question": {
            "type": "string",
            "enum": [
              "revenue",
              "average",
              "top_products",
              "stock_alerts"
            ],
            "title": "Question"
          },
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start",
            "default": "2026-11-01"
          },
          "end": {
            "type": "string",
            "format": "date",
            "title": "End",
            "default": "2026-11-07"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AssistantRequest"
      },
      "CartLine": {
        "properties": {
          "product_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 999.0,
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "CartLine"
      },
      "DailyRevenue": {
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "revenue_minor": {
            "type": "integer",
            "maximum": 999999999999.0,
            "minimum": 0.0,
            "title": "Revenue Minor"
          },
          "sales_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Sales Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "day",
          "revenue_minor",
          "sales_count"
        ],
        "title": "DailyRevenue"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Product": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id"
          },
          "code": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Code"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "category": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Category"
          },
          "price_minor": {
            "type": "integer",
            "maximum": 999999999999.0,
            "minimum": 0.0,
            "title": "Price Minor"
          },
          "stock": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Stock"
          },
          "minimum_stock": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Minimum Stock"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "category",
          "price_minor",
          "stock",
          "minimum_stock"
        ],
        "title": "Product"
      },
      "Report": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "demo",
            "title": "Mode",
            "default": "demo"
          },
          "summary": {
            "$ref": "#/components/schemas/Summary"
          },
          "inventory": {
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "type": "array",
            "title": "Inventory"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": "Ventas del periodo; existencias actuales ficticias, no históricas."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary",
          "inventory"
        ],
        "title": "Report"
      },
      "Sale": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id"
          },
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/SaleLine"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Lines"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "day",
          "lines"
        ],
        "title": "Sale"
      },
      "SaleLine": {
        "properties": {
          "product_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 999.0,
            "minimum": 1.0,
            "title": "Quantity"
          },
          "unit_price_minor": {
            "type": "integer",
            "maximum": 999999999999.0,
            "minimum": 0.0,
            "title": "Unit Price Minor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "quantity",
          "unit_price_minor"
        ],
        "title": "SaleLine"
      },
      "SalePreview": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "demo",
            "title": "Mode",
            "default": "demo"
          },
          "persisted": {
            "type": "boolean",
            "const": false,
            "title": "Persisted",
            "default": false
          },
          "currency": {
            "type": "string",
            "const": "PEN",
            "title": "Currency",
            "default": "PEN"
          },
          "total_minor": {
            "type": "integer",
            "maximum": 999999999999.0,
            "minimum": 0.0,
            "title": "Total Minor"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/SaleLine"
            },
            "type": "array",
            "title": "Lines"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "total_minor",
          "lines"
        ],
        "title": "SalePreview"
      },
      "SalePreviewRequest": {
        "properties": {
          "lines": {
            "items": {
              "$ref": "#/components/schemas/CartLine"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Lines"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lines"
        ],
        "title": "SalePreviewRequest"
      },
      "Snapshot": {
        "properties": {
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version"
          },
          "mode": {
            "type": "string",
            "const": "demo",
            "title": "Mode"
          },
          "currency": {
            "type": "string",
            "const": "PEN",
            "title": "Currency"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "title": "As Of"
          },
          "products": {
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "type": "array",
            "maxItems": 5000,
            "title": "Products"
          },
          "sales": {
            "items": {
              "$ref": "#/components/schemas/Sale"
            },
            "type": "array",
            "maxItems": 5000,
            "title": "Sales"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "mode",
          "currency",
          "as_of",
          "products",
          "sales"
        ],
        "title": "Snapshot"
      },
      "Summary": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "demo",
            "title": "Mode",
            "default": "demo"
          },
          "currency": {
            "type": "string",
            "const": "PEN",
            "title": "Currency",
            "default": "PEN"
          },
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date",
            "title": "End"
          },
          "revenue_minor": {
            "type": "integer",
            "maximum": 999999999999.0,
            "minimum": 0.0,
            "title": "Revenue Minor"
          },
          "sales_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Sales Count"
          },
          "stock_units": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Stock Units"
          },
          "alert_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Alert Count"
          },
          "daily": {
            "items": {
              "$ref": "#/components/schemas/DailyRevenue"
            },
            "type": "array",
            "title": "Daily"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end",
          "revenue_minor",
          "sales_count",
          "stock_units",
          "alert_count",
          "daily"
        ],
        "title": "Summary"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
