<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23723" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-controller">
 <device id="retina6_12" orientation="portrait" appearance="light"/>
 <dependencies><plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23721"/><capability name="Safe area layout guides" minToolsVersion="9.0"/></dependencies>
 <scenes><scene sceneID="launch-scene"><objects>
  <viewController id="launch-controller" sceneMemberID="viewController"><view key="view" contentMode="scaleToFill" id="launch-view">
   <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
   <subviews>
    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="DataCore AI" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="launch-title"><rect key="frame" x="96" y="400" width="201" height="40"/><fontDescription key="fontDescription" type="system" weight="bold" pointSize="32"/><color key="textColor" red="0.949" green="0.961" blue="0.980" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></label>
    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Tu negocio, con perspectiva." textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="launch-subtitle"><rect key="frame" x="90" y="454" width="213" height="20"/><fontDescription key="fontDescription" type="system" pointSize="15"/><color key="textColor" red="0.141" green="0.788" blue="0.753" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></label>
