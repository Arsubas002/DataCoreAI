// Override on the command line or in an untracked Local.xcconfig, never commit signing secrets.
DATACORE_BUNDLE_ID = org.example.datacoreai.demo
DATACORE_DEVELOPMENT_TEAM =
#include? "Local.xcconfig"
PRODUCT_BUNDLE_IDENTIFIER = $(DATACORE_BUNDLE_ID)
DEVELOPMENT_TEAM = $(DATACORE_DEVELOPMENT_TEAM)
CODE_SIGN_STYLE = Automatic
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
TARGETED_DEVICE_FAMILY = 1
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
INFOPLIST_FILE = DataCoreAI/Resources/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ENABLE_USER_SCRIPT_SANDBOXING = YES
